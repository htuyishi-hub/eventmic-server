# Environment mode: "production" enforces strict secret validation, strong passcode, and CORS/WS origin checks
NODE_ENV=production

# Server listening port (Render/Railway sets this automatically)
PORT=3001

# LiveKit Cloud WebSocket URL
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API Key (generated in LiveKit dashboard)
LIVEKIT_API_KEY=your-api-key

# LiveKit API Secret (generated in LiveKit dashboard; also used as default secret for signing HMAC tokens)
LIVEKIT_API_SECRET=your-api-secret

# Dedicated secret for HMAC-SHA256 client API tokens (optional; falls back to LIVEKIT_API_SECRET)
API_TOKEN_SECRET=your-random-token-signing-secret

# Admin / audio engineer authentication passcode (MUST NOT be 1234 in production)
HOST_PASSCODE=change_me_to_a_strong_random_passcode

# Comma-separated list of allowed web origins for CORS and WebSocket connections
ALLOWED_ORIGINS=https://eventmic.live,https://your-app.vercel.app

# Set to "true" to allow all https://*.vercel.app preview deployment URLs for CORS and WebSockets
ALLOW_VERCEL_PREVIEWS=true

# Optional Supabase persistence for multi-admin accounts & recurring calendar
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
